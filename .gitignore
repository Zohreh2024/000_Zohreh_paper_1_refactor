
# --------------------------------------------------------------------------- #
# Data  (~1.67 TB)
# --------------------------------------------------------------------------- #
# Everything under Data/ is either downloaded from a public source or
# regenerated by the Step_0 scripts, so none of it belongs in git. See
# CLAUDE.md "Data sources" for where each layer comes from.
#
# The one exception is the NLUM mask: it is 0.34 MB, it is the reference grid
# every other raster is matched to, and nothing in this repo can regenerate it.
# Git cannot re-include a file whose parent directory is still excluded, so the
# directory is un-excluded here; the file itself is re-included at the very
# BOTTOM of this file, after the broad *.tif rule that would otherwise win.
Data/*
!Data/NLUM_Mask/
Data/NLUM_Mask/*


# --------------------------------------------------------------------------- #
# Generated model artefacts
# --------------------------------------------------------------------------- #
# X_data.nc 874 MB, Y_data.nc 18 MB, random_forest_model.pkl 1.2 GB, plus the
# 16 prediction rasters - all rebuilt by Step_01 / Step_02 / Step_03.
Step_1_RF_for_FPI/data/
Step_1_RF_for_FPI/output/


# --------------------------------------------------------------------------- #
# Validation_GEDI generated data
# --------------------------------------------------------------------------- #
# Footprints (532 MB parquet + per-granule checkpoints), per-cell tables
# (~145 MB) and granule download caches are all rebuilt by Step_02 to Step_04.
# The summary tables in outputs/analysis/, figures, logs and both .docx stay.
Validation_GEDI/gedi_granules/
Validation_GEDI/modis_granules/
Validation_GEDI/outputs/gedi_parts/
Validation_GEDI/outputs/**/*.parquet
Validation_GEDI/outputs/**/gedi_cells_*.csv


# --------------------------------------------------------------------------- #
# Large binary formats, wherever they appear
# --------------------------------------------------------------------------- #
# Pickles are also version-fragile: an sklearn pickle rarely survives a library
# upgrade, so committing one gives a false sense of reproducibility.
*.pkl
*.tif
*.tiff
*.nc
*.zip
*.ovr
*.aux.xml
*.tfw

# Half-written output from an interrupted run
*.tmp
*.part


# --------------------------------------------------------------------------- #
# Python
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# CSIRO DAP file manifest, re-fetchable with --refresh-manifest (~30 MB)
.dap_*_manifest.json
htmlcov/
build/
dist/
*.egg-info/

# Environments
.venv/
venv/
env/


# --------------------------------------------------------------------------- #
# Editors / OS / network-share detritus
# --------------------------------------------------------------------------- #
.vscode/
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.c~
*.conda_trash
.~lock.*


# --------------------------------------------------------------------------- #
# Claude Code
# --------------------------------------------------------------------------- #
# Shared project settings are worth committing; machine-local overrides are not.
.claude/settings.local.json


# --------------------------------------------------------------------------- #
# FPI_Accuracy_check generated layers  (~8.9 GB)
# --------------------------------------------------------------------------- #
# The 30 modelled historical FPI rasters, the four Eq.(1) M denominators and the
# 256 M' rasters are all rebuilt by Step_01 / Step_03 / Step_04 of that folder.
# The CSVs, figures and the report are kept, since they are the result.
FPI_Accuracy_check/output/*.tif
FPI_Accuracy_check/output_Mprime_rf/
FPI_Accuracy_check/logs/
FPI_Accuracy_check/Comparison_vs_New_M_2019/output/cv/
FPI_Accuracy_check/Comparison_vs_New_M_2019/logs/


# --------------------------------------------------------------------------- #
# Space-for-time validation intermediates
# --------------------------------------------------------------------------- #
# `tables/` is Dataframe 2: nine predictor tables of 69,564 cells x 174 columns
# (~460 MB as npz + slim CSV), rebuilt by Step_02 in about five minutes.
# `matches*.csv` is one row per site per run, rebuilt by Step_03 in two.
# Dataframe 1 (reference_table.csv, 4 MB) IS kept - it is the deliverable and
# rebuilding it needs the whole climate stack.
Validation_M/National_biomass_library/Space_time_validation/outputs/tables/
Validation_M/National_biomass_library/Space_time_validation/outputs/matches*.csv
Validation_M/National_biomass_library/Space_time_validation/logs/


# --------------------------------------------------------------------------- #
# The National Biomass Library download. biolib_treelist.csv is 154 MB,
# over GitHub's hard limit, and both files are an unmodified third-party
# download - fetched, not produced here. See NBL_download/README.md.
Validation_M/National_biomass_library/NBL_download/
Validation_M/National_biomass_library/NBL_previousdownload/

# Re-inclusions - MUST stay last
# --------------------------------------------------------------------------- #
# gitignore is last-match-wins, so a negation only survives if nothing below it
# re-excludes the path. The broad *.tif rule above would otherwise swallow the
# NLUM template. Verified with `git check-ignore -v`.
!Data/NLUM_Mask/NLUM_2010-11_mask.tif
